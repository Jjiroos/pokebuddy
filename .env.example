# Copier en .env et remplacer les valeurs. .env est ignoré par git.

# --- LLM ---------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=remplacer-par-une-vraie-cle
OPENAI_MODEL=gpt-5.6-luna

# Passerelle compatible OpenAI. Laisser vide pour viser l'API d'OpenAI.
# Attention : le provider parle l'API Responses (/responses), pas
# /chat/completions. Seules les passerelles qui l'exposent fonctionnent.
# Groq — palier Developer gratuit, sans carte bancaire (30 req/min, 1 000/jour) :
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#   OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=

# La famille GPT-5 refuse `temperature` (400 : only the default (1) is
# supported). La reproductibilité vient du cache disque + du pinning de
# ces deux leviers. Voir src/llm/openai_provider.py.
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low
OPENAI_TIMEOUT_S=60
OPENAI_MAX_RETRIES=5

# --- Base de données ---------------------------------------------------
POSTGRES_USER=pokebuddy
POSTGRES_PASSWORD=pokebuddy
POSTGRES_DB=pokebuddy
# Port exposé sur l'hôte (5432 est souvent déjà pris par un Postgres local).
POSTGRES_HOST_PORT=5433

# Vues depuis l'HÔTE : ce sont elles que `make eval` utilise. Le conteneur api
# reçoit ses propres URL en db:5432 via docker-compose.yml, qui priment.
DATABASE_URL=postgresql+psycopg://pokebuddy:pokebuddy@localhost:5433/pokebuddy

# Rôle sans aucun droit d'écriture, réservé à l'outil SQL du jalon 3. Le mot de
# passe qui figure ici est celui que la migration pose sur le rôle : les deux ne
# peuvent pas diverger, elle le lit dans cette URL.
DATABASE_URL_RO=postgresql+psycopg://pokebuddy_ro:pokebuddy_ro@localhost:5433/pokebuddy
POSTGRES_RO_PASSWORD=pokebuddy_ro

# --- Caches ------------------------------------------------------------
# À garder hors du dépôt : un seul fichier SQLite et une arborescence de JSON,
# tous deux lents sur un montage réseau ou Windows.
LLM_CACHE_PATH=~/.cache/pokebuddy/llm.sqlite
POKEAPI_CACHE_DIR=~/.cache/pokebuddy/pokeapi
TCGDEX_CACHE_DIR=~/.cache/pokebuddy/tcgdex
FASTEMBED_CACHE_DIR=~/.cache/pokebuddy/fastembed
